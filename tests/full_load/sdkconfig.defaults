# ESP-IDF 5.5.5 defaults for the bounded Full Load power test.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_M5SW_TEST_ID="full-load"
CONFIG_M5SW_CONFIG_ID="full-load"
# Full Load must remain blocked until the external safety record is approved.
CONFIG_M5SW_FULL_LOAD_SAFETY_ACK=n
# Keep credentials out of committed defaults. Set them in the local sdkconfig.
CONFIG_M5SW_WIFI_SSID=""
CONFIG_M5SW_WIFI_PASSWORD=""
CONFIG_M5SW_WIFI_TARGET_IPV4=""
CONFIG_M5SW_WIFI_LISTEN_INTERVAL=3
